params {

    template_dir = "${projectDir}/templates"
    mni152_template = "${params.template_dir}/MNI152_T1_1mm.nii.gz"
    optic_nerve_atlas = "${params.template_dir}/Atlas_MNI.nii.gz"
    optic_nerve_label = "${params.template_dir}/Optic_Nerve_Label_MNI.nii.gz"

    registration.dwi_to_t1w_type = 'r'        // DWI b0 to T1w: rigid
    registration.t1w_to_mni_type = 'r'        // T1w to MNI: rigid
    registration.roi_refinement_type = 'r'    // ROI-based refinement: rigid

    registration.interpolation.default = 'Linear'                // Default for anatomical images
    registration.interpolation.segmentation = 'NearestNeighbor'  // Preserve discrete labels
    registration.interpolation.fa_map = 'NearestNeighbor'        // FA maps (preserve values)
    registration.interpolation.dwi = 'NearestNeighbor'           // DWI volumes
    registration.interpolation.t1map = 'Linear'                  // Quantitative T1 maps

    registration.roi_coordinates.x_start = 40    // Starting voxel in X dimension
    registration.roi_coordinates.y_start = 101   // Starting voxel in Y dimension
    registration.roi_coordinates.z_start = 140   // Starting voxel in Z dimension
    registration.roi_coordinates.x_size = 60     // Size in X dimension (voxels)
    registration.roi_coordinates.y_size = 22     // Size in Y dimension (voxels)
    registration.roi_coordinates.z_size = 25     // Size in Z dimension (voxels)
        

    // Base directory for pipeline outputs (BIDS derivatives)
    output.base_dir = "derivatives/onflow"

    // Publish directory mode
    // Options: 'copy', 'symlink', 'rellink', 'link'
    output.publish_mode = 'copy'

    // Output file compression
    output.compress_outputs = true

    // Save intermediate files (transforms, ROIs)
    output.save_intermediates = false

    // ANTs container for registration and transform application
    // Should include: antsRegistrationSyN.sh, antsApplyTransforms
    containers.ants = "antsx/ants:latest"

    // FSL container for ROI extraction and b0 extraction
    // Should include: fslroi
    containers.fsl = "brainlife/fsl:6.0.4"

}

process {

    // Registration processes (memory intensive)
    withName: 'ANTS_REGISTRATION_SYN' {
        publishDir = [mode: params.output.publish_mode, path: params.output.base_dir]
        memory = { 6.GB * task.attempt }
        cpus = 2
        time = { 2.h * task.attempt }
        errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
        maxRetries = 2
    }

    withName: 'ANTS_APPLY_TRANSFORMS' {
        publishDir = [mode: params.output.publish_mode, path: params.output.base_dir]
        memory = { 4.GB * task.attempt }
        cpus = 1
        time = { 1.h * task.attempt }
        errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
        maxRetries = 2
    }

    withName: 'FSL_ROI' {
        publishDir = [mode: params.output.publish_mode, path: params.output.base_dir]
        memory = { 2.GB * task.attempt }
        cpus = 1
        time = { 30.m * task.attempt }
        errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
        maxRetries = 2
    }

    // b0 extraction (low resources)
    withName: 'DWI_B0_EXTRACTION' {
        publishDir = [mode: params.output.publish_mode, path: params.output.base_dir]
        memory = { 2.GB * task.attempt }
        cpus = 1
        time = { 30.m * task.attempt }
        errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
        maxRetries = 2
    }

    withName: 'COPY_TO_DERIVATIVES' {
        publishDir = [mode: params.output.publish_mode, path: params.output.base_dir]
        memory = { 1.GB * task.attempt }
        cpus = 1
        time = { 15.m * task.attempt }
        errorStrategy = 'finish'
    }
}

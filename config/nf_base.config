
params {
    // BIDS workflow configuration
    bids2nf_config = "${projectDir}/config/bids2nf.yaml"
    libbids_sh = "${projectDir}/bids2nf/libBIDS.sh/libBIDS.sh"
    includeBidsParentDir = true

    // Local resource limits
    max_memory = '2 GB'
    max_cpus = 2
    max_time = '30m'

    // Debugging and validation
    debug_mode = true
    log_level = 'INFO'
    bids_validation = false
}

// Enable Docker for container processes
docker {
    enabled = true
}

process {
    executor = 'local'

    // Default resource allocation
    memory = '1 GB'
    cpus = 1
    time = '30m'

    // Quick failure for development
    errorStrategy = 'terminate'
    maxRetries = 1
}

// Enable all reporting for development
timeline.enabled = true
report.enabled = true
trace.enabled = true
trace.overwrite = true
dag.enabled = true

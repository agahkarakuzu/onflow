
params {
    // BIDS workflow configuration (see https://agah.dev/bids2nf/configuration)
    bids2nf_config = "${projectDir}/config/bids2nf/onflow.yaml"

    // Directory where libBIDS.sh is located (not the shell script, the folder containing it. I know, folder names are not expected to have extensions)
    // This is because the actual repository name is a bit confusing (https://github.com/agahkarakuzu/libBIDS.sh), fork from CobraLab
    // Anyway, here it exists as a submodule of the bids2nf submodule.
    libbids_sh = "${projectDir}/bids2nf/libBIDS.sh"

    // LibBIDS.sh by default recognizes suffixes and entities that are in the official BIDS specification.
    // However, most datasets may have custom suffixes or entities. Any json file placed in the libbids_config_dir will be
    // automatically read by libBIDS.sh to extend its recognition capability.
    libbids_config_dir = "${projectDir}/config/libBIDS.sh"
    includeBidsParentDir = true

    // Local resource limits
    max_memory = '2 GB'
    max_cpus = 2
    max_time = '30m'

    // Debugging and validation
    debug_mode = true
    log_level = 'INFO'
    bids_validation = false
}

// Enable Docker for container processes
docker {
    enabled = true
}

process {
    executor = 'local'

    // Default resource allocation
    memory = '1 GB'
    cpus = 1
    time = '30m'

    // Quick failure for development
    errorStrategy = 'terminate'
    maxRetries = 1
}

// Enable all reporting for development
timeline.enabled = true
report.enabled = true
trace.enabled = true
trace.overwrite = true
dag.enabled = true

process {
    // Shell configuration for AMD64 systems (Intel/AMD)
    // libBIDS.sh requires bash 4.0+
    // Adjust path if needed: /bin/bash, /usr/bin/bash, or /usr/local/bin/bash
    withName: 'libbids_sh_parse' {
        shell = ['/bin/bash', '-ue']
    }
    
    withName: 'BIDS_VALIDATOR' {
        container = 'bids/validator:latest'
    }
}
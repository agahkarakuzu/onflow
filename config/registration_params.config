
params {

    template_dir = "${projectDir}/templates"

    mni152_template = "${params.template_dir}/MNI152_T1_1mm.nii.gz"


    optic_nerve_atlas = "${params.template_dir}/Atlas_MNI.nii.gz"


    optic_nerve_label = "${params.template_dir}/Optic_Nerve_Label_MNI.nii.gz"

    registration {

        // Registration types for each stage
        // Options: 'r' (rigid), 'a' (affine), 's' (syn/deformable)
        dwi_to_t1w_type = 'r'        // DWI b0 to T1w: rigid
        t1w_to_mni_type = 'r'        // T1w to MNI: rigid
        roi_refinement_type = 'r'    // ROI-based refinement: rigid

        // Interpolation methods for different image types
        // Options: 'Linear', 'NearestNeighbor', 'BSpline', 'CosineWindowedSinc'
        interpolation {
            default = 'Linear'                // Default for anatomical images
            segmentation = 'NearestNeighbor'  // Preserve discrete labels
            fa_map = 'NearestNeighbor'        // FA maps (preserve values)
            dwi = 'NearestNeighbor'           // DWI volumes
            t1map = 'Linear'                  // Quantitative T1 maps
        }

        // ROI coordinates in MNI space for optic nerve region
        // These coordinates define the bounding box for ROI extraction
        // Format: fslroi INPUT OUTPUT x_start x_size y_start y_size z_start z_size
        // Original hardcoded values: 40 101 140 60 22 25
        roi_coordinates {
            x_start = 40    // Starting voxel in X dimension
            y_start = 101   // Starting voxel in Y dimension
            z_start = 140   // Starting voxel in Z dimension
            x_size = 60     // Size in X dimension (voxels)
            y_size = 22     // Size in Y dimension (voxels)
            z_size = 25     // Size in Z dimension (voxels)
        }
    }

    output {
        // Base directory for pipeline outputs (BIDS derivatives)
        base_dir = "derivatives/onflow"

        // Publish directory mode
        // Options: 'copy', 'symlink', 'rellink', 'link'
        publish_mode = 'copy'

        // Output file compression
        compress_outputs = true

        // Save intermediate files (transforms, ROIs)
        save_intermediates = false
    }

    containers {
        // ANTs container for registration and transform application
        // Should include: antsRegistrationSyN.sh, antsApplyTransforms
        ants = "antsx/ants:latest"

        // FSL container for ROI extraction and b0 extraction
        // Should include: fslroi
        fsl = "brainlife/fsl:6.0.4"
    }


    max_memory = '8.GB'
    max_cpus = 4
    max_time = '4.h'

    enable_trace = true
    enable_timeline = true
    enable_report = true
}

// ========================================
// Process-Specific Resource Configuration
// ========================================
process {

    // Registration processes (memory intensive)
    withName: 'ANTS_REGISTRATION_SYN' {
        publishDir = [mode: params.output.publish_mode, path: params.output.base_dir]
        memory = { 6.GB * task.attempt }
        cpus = 2
        time = { 2.h * task.attempt }
        errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
        maxRetries = 2
    }

    withName: 'ANTS_APPLY_TRANSFORMS' {
        publishDir = [mode: params.output.publish_mode, path: params.output.base_dir]
        memory = { 4.GB * task.attempt }
        cpus = 1
        time = { 1.h * task.attempt }
        errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
        maxRetries = 2
    }

    withName: 'FSL_ROI' {
        publishDir = [mode: params.output.publish_mode, path: params.output.base_dir]
        memory = { 2.GB * task.attempt }
        cpus = 1
        time = { 30.m * task.attempt }
        errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
        maxRetries = 2
    }

    // b0 extraction (low resources)
    withName: 'DWI_B0_EXTRACTION' {
        publishDir = [mode: params.output.publish_mode, path: params.output.base_dir]
        memory = { 2.GB * task.attempt }
        cpus = 1
        time = { 30.m * task.attempt }
        errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
        maxRetries = 2
    }

    withName: 'COPY_TO_DERIVATIVES' {
        publishDir = [mode: params.output.publish_mode, path: params.output.base_dir]
        memory = { 1.GB * task.attempt }
        cpus = 1
        time = { 15.m * task.attempt }
        errorStrategy = 'finish'
    }
}
